{
  "comment": "Cases for rikugan_ida_tooltest, run in order against a system binary (/bin/ls; notepad.exe on Windows). ${...} are values found in the database at run time. A case passes when its result is not an error (or is one, with expect_error) and contains expect_contains.",
  "cases": [
    {"tool": "get_cursor_position", "args": {}, "expect_contains": "${func}"},
    {"tool": "get_current_function", "args": {}, "expect_contains": "Name: ${func_name}"},
    {"tool": "jump_to", "args": {"address": "${func}"}, "expect_contains": "${func}"},
    {"tool": "get_name_at", "args": {"address": "${func}"}, "expect_contains": "${func_name}"},
    {"tool": "get_address_of", "args": {"name": "${func_name}"}, "expect_contains": "${func}"},
    {"tool": "get_address_of", "args": {"name": "rk_no_such_symbol"}, "expect_contains": "Symbol not found: rk_no_such_symbol"},

    {"tool": "list_functions", "args": {"offset": 0, "limit": 5}, "expect_contains": "Functions 0\u20135 of "},
    {"tool": "get_function_info", "args": {"address": "${func}"}, "expect_contains": "Basic blocks: "},
    {"tool": "get_function_info", "args": {"address": "0x1"}, "expect_contains": "No function at 0x1"},
    {"tool": "search_functions", "args": {"query": "${func_name}", "limit": 5}, "expect_contains": "${func_name}"},

    {"tool": "list_strings", "args": {"offset": 0, "limit": 5}, "expect_contains": "Strings 0\u20135 of "},
    {"tool": "search_strings", "args": {"query": "${string_query}", "limit": 3}, "expect_contains": "${string_query}"},
    {"tool": "get_string_at", "args": {"address": "${string_ea}"}, "expect_contains": "${string_query}"},

    {"tool": "list_segments", "args": {}, "expect_contains": ".text"},
    {"tool": "list_imports", "args": {"offset": 0, "limit": 10}, "expect_contains": "Imports 0-"},
    {"tool": "list_exports", "args": {}, "expect_contains": "Exports 0-"},
    {"tool": "get_binary_info", "args": {}, "expect_contains": "Bits: 64"},
    {"tool": "read_bytes", "args": {"address": "${func}", "size": 40}, "expect_contains": "|"},
    {"tool": "read_global_value", "args": {"address": "${string_ea}"}, "expect_contains": "UTF-8 string: '${string_query}"},
    {"tool": "read_global_value", "args": {"address": "${func_name}", "type_hint": "u32"}, "expect_contains": "u32: "},
    {"tool": "read_global_value", "args": {"address": "rk_no_such_symbol"}, "expect_error": true},

    {"tool": "read_disassembly", "args": {"address": "${func}", "limit": 8}, "expect_contains": "instructions 0-8:"},
    {"tool": "read_function_disassembly", "args": {"address": "${func}", "limit": 10}, "expect_contains": "Disassembly for function ${func} 0-10 of "},
    {"tool": "get_instruction_info", "args": {"address": "${func}"}, "expect_contains": "Mnemonic: "},

    {"tool": "decompile_function", "args": {"address": "${func}", "limit": 20}, "expect_contains": "Pseudocode for ${func} 0-"},
    {"tool": "get_decompiler_variables", "args": {"address": "${func}"}, "expect_contains": "${lvar}"},
    {"tool": "set_pseudocode_comment", "args": {"func_address": "${func}", "target_address": "${func_insn}", "comment": "rk pseudo comment"}, "expect_contains": "Set pseudocode comment at "},
    {"tool": "get_pseudocode_comment", "args": {"func_address": "${func}", "target_address": "${func_insn}"}, "expect_contains": "rk pseudo comment"},

    {"tool": "xrefs_to", "args": {"address": "${func}"}, "expect_contains": "Cross-references to ${func}"},
    {"tool": "xrefs_from", "args": {"address": "${func_insn}"}, "expect_contains": "Cross-references from ${func_insn}:"},
    {"tool": "function_xrefs", "args": {"address": "${func}"}, "expect_contains": "Callers ("},

    {"tool": "rename_function", "args": {"address": "${func}", "new_name": "rk_renamed_fn"}, "expect_contains": "Renamed ${func}: ${func_name} \u2192 rk_renamed_fn"},
    {"tool": "read_function_name", "args": {"address": "${func}"}, "expect_contains": "rk_renamed_fn"},
    {"tool": "rename_function", "args": {"address": "${func}", "new_name": "${func_name}"}, "expect_contains": "Renamed"},
    {"tool": "rename_variable", "args": {"func_address": "${func}", "old_name": "${lvar}", "new_name": "rk_var"}, "expect_contains": "Renamed variable: ${lvar} \u2192 rk_var"},
    {"tool": "rename_variable", "args": {"func_address": "${func}", "old_name": "rk_var", "new_name": "${lvar}"}, "expect_contains": "Renamed variable"},
    {"tool": "set_comment", "args": {"address": "${func_insn}", "comment": "rk comment"}, "expect_contains": "Set comment at ${func_insn}: rk comment"},
    {"tool": "read_comment", "args": {"address": "${func_insn}"}, "expect_contains": "rk comment"},
    {"tool": "set_function_comment", "args": {"address": "${func}", "comment": "rk fn comment", "repeatable": true}, "expect_contains": "Set function comment at ${func}"},
    {"tool": "read_function_comment", "args": {"address": "${func}", "repeatable": true}, "expect_contains": "rk fn comment"},
    {"tool": "rename_address", "args": {"address": "${data_ea}", "new_name": "rk_data_label"}, "expect_contains": "\u2192 rk_data_label"},
    {"tool": "set_type", "args": {"address": "${data_ea}", "type_string": "int"}, "expect_contains": "Set type at ${data_ea}: int"},
    {"tool": "read_function_prototype", "args": {"address": "${func}"}},

    {"tool": "create_struct", "args": {"name": "RkStruct", "fields": "[{\"name\": \"a\", \"type\": \"int\"}, {\"name\": \"b\", \"type\": \"char *\", \"offset\": 8, \"comment\": \"ptr\"}]"}, "expect_contains": "Created struct 'RkStruct' with 2 fields, size=16"},
    {"tool": "create_struct", "args": {"name": "RkStruct", "fields": "[]"}, "expect_contains": "Struct 'RkStruct' already exists"},
    {"tool": "create_struct", "args": {"name": "RkBad", "fields": "not json"}, "expect_error": true},
    {"tool": "modify_struct", "args": {"name": "RkStruct", "action": "add_field", "field_name": "c", "field_type": "unsigned short", "offset": 16}, "expect_contains": "Added field 'c' (unsigned short) to 'RkStruct'"},
    {"tool": "modify_struct", "args": {"name": "RkStruct", "action": "rename_field", "field_name": "c", "new_name": "cc"}, "expect_contains": "Renamed 'c' \u2192 'cc'"},
    {"tool": "modify_struct", "args": {"name": "RkStruct", "action": "retype_field", "field_name": "cc", "field_type": "short"}, "expect_contains": "Retyped 'cc' to 'short'"},
    {"tool": "modify_struct", "args": {"name": "RkStruct", "action": "set_field_comment", "field_name": "a", "comment": "first"}, "expect_contains": "Set comment on 'a'"},
    {"tool": "modify_struct", "args": {"name": "RkStruct", "action": "remove_field", "field_name": "cc"}, "expect_contains": "Removed field 'cc' from 'RkStruct'"},
    {"tool": "modify_struct", "args": {"name": "RkStruct", "action": "bogus"}, "expect_contains": "Unknown action: bogus"},
    {"tool": "get_struct_info", "args": {"name": "RkStruct"}, "expect_contains": "; first"},
    {"tool": "list_structs", "args": {"filter": "RkStr"}, "expect_contains": "RkStruct"},
    {"tool": "create_enum", "args": {"name": "RkEnum", "members": "[{\"name\": \"RK_A\", \"value\": 1}, {\"name\": \"RK_B\", \"value\": 2}]"}, "expect_contains": "Created enum 'RkEnum' with 2 members"},
    {"tool": "modify_enum", "args": {"name": "RkEnum", "action": "add_member", "member_name": "RK_C", "value": 4}, "expect_contains": "Added 'RK_C' = 4"},
    {"tool": "modify_enum", "args": {"name": "RkEnum", "action": "remove_member", "member_name": "RK_C"}, "expect_contains": "remove_member requires ida_enum"},
    {"tool": "get_enum_info", "args": {"name": "RkEnum"}, "expect_contains": "= 0x4 (4)"},
    {"tool": "list_enums", "args": {"filter": "RkEn"}, "expect_contains": "RkEnum"},
    {"tool": "create_typedef", "args": {"name": "rk_u32", "base_type": "unsigned int"}, "expect_contains": "Created typedef: typedef unsigned int rk_u32;"},
    {"tool": "apply_struct_to_address", "args": {"struct_name": "RkStruct", "address": "${data_ea}"}, "expect_contains": "Applied struct 'RkStruct' at ${data_ea} (16 bytes)"},
    {"tool": "apply_type_to_variable", "args": {"func_address": "${func}", "var_name": "${lvar}", "type_str": "${lvar_type}"}, "expect_contains": "Set type of '${lvar}'"},
    {"tool": "read_function_prototype", "args": {"address": "${func}"}, "expect_contains": "${func_proto}"},
    {"tool": "set_function_prototype", "args": {"address": "${func}", "prototype": "${func_decl}"}, "expect_contains": "Set prototype at ${func}: ${func_decl}"},
    {"tool": "set_function_prototype", "args": {"address": "${func}", "prototype": "${func_proto}"}, "expect_contains": "Failed to set prototype. Check syntax: "},
    {"tool": "import_c_header", "args": {"c_code": "struct RkHdr { int x; char y; };"}, "expect_contains": "Successfully parsed C declarations (0 type(s) defined)"},
    {"tool": "suggest_struct_from_accesses", "args": {"address": "${func}"}},
    {"tool": "propagate_type", "args": {"struct_name": "RkStruct"}, "expect_contains": "Triggered type propagation for 'RkStruct'"},
    {"tool": "get_type_libraries", "args": {}, "expect_contains": "Type libraries:"},
    {"tool": "import_type_from_library", "args": {"til_name": "${til}", "type_name": "rk_missing_type"}, "expect_contains": "Type 'rk_missing_type' not found in '${til}'"},

    {"tool": "execute_python", "args": {"code": "print(idc.get_func_name(${func}))"}, "expect_contains": "stdout:\n${func_name}"},
    {"tool": "execute_python", "args": {"code": "rk_counter = 41"}, "expect_contains": "(no output)"},
    {"tool": "execute_python", "args": {"code": "print(rk_counter + 1)\nraise ValueError('boom')"}, "expect_contains": "stdout:\n42\n\nstderr:\nValueError: boom"},
    {"tool": "execute_python", "args": {"code": "import subprocess"}, "expect_contains": "Error: Blocked \u2014 import of disallowed module 'subprocess'"},

    {"tool": "get_microcode", "args": {"address": "${func}", "maturity": "MMAT_LOCOPT"}, "expect_contains": "=== Microcode for ${func_name} (${func}) at MMAT_LOCOPT ==="},
    {"tool": "get_microcode", "args": {"address": "${func}"}, "expect_contains": "Blocks: "},
    {"tool": "get_microcode", "args": {"address": "${func}", "maturity": "MMAT_BOGUS"}, "expect_error": true},
    {"tool": "get_microcode_block", "args": {"address": "${func}", "block_index": 1}, "expect_contains": "=== Block 1 of ${func_name}"},
    {"tool": "get_microcode_block", "args": {"address": "${func}", "block_index": 100000}, "expect_contains": "out of range"},
    {"tool": "nop_microcode", "args": {"func_address": "${func}", "instruction_addresses": "${func_insn}", "optimizer_name": "rk_nop"}, "expect_contains": "Optimizer 'rk_nop' installed"},
    {"tool": "install_microcode_optimizer", "args": {"name": "rk_dyn", "description": "no-op", "optimizer_type": "instruction", "python_code": "def optimize(blk, ins):\n    return 0\n"}, "expect_contains": "Optimizer 'rk_dyn' (instruction) installed successfully."},
    {"tool": "install_microcode_optimizer", "args": {"name": "rk_bad", "description": "x", "optimizer_type": "block", "python_code": "x = 1\n"}, "expect_contains": "Code must define a callable 'optimize' function."},
    {"tool": "install_microcode_optimizer", "args": {"name": "rk_dyn", "description": "x", "optimizer_type": "block", "python_code": "def optimize(blk):\n    return 0\n"}, "expect_contains": "Optimizer 'rk_dyn' already exists."},
    {"tool": "list_microcode_optimizers", "args": {}, "expect_contains": "rk_dyn [instruction] \u2014 no-op"},
    {"tool": "redecompile_function", "args": {"address": "${func}"}, "expect_contains": "Active optimizers: rk_nop, rk_dyn"},
    {"tool": "remove_microcode_optimizer", "args": {"name": "rk_dyn"}, "expect_contains": "Optimizer 'rk_dyn' removed."},
    {"tool": "remove_microcode_optimizer", "args": {"name": "rk_nop"}, "expect_contains": "Optimizer 'rk_nop' removed."},
    {"tool": "remove_microcode_optimizer", "args": {"name": "rk_nop"}, "expect_contains": "No optimizer named 'rk_nop'. Active optimizers: (none)"},
    {"tool": "list_microcode_optimizers", "args": {}, "expect_contains": "No microcode optimizers installed."},
    {"tool": "redecompile_function", "args": {"address": "${func}"}, "expect_contains": "No optimizers active"}
  ]
}
