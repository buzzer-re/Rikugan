# cmake -DROOT=<repo> -DLIST=<file list> -DOUT=<cpp> -P embed_gen.cmake
file(STRINGS "${LIST}" _files)
set(_body "// generated by cmake/embed_gen.cmake; do not edit\n#include \"common/util/Embedded.h\"\n\nnamespace rk {\nnamespace {\n")
set(_table "")
set(_i 0)
foreach(_f ${_files})
    if(_f STREQUAL "")
        continue()
    endif()
    file(RELATIVE_PATH _rel "${ROOT}" "${_f}")
    file(READ "${_f}" _hex HEX)
    file(SIZE "${_f}" _size)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "'\\\\x\\1'," _bytes "${_hex}")
    string(APPEND _body "const char d${_i}[] = {${_bytes}0};\n")
    string(APPEND _table "    {\"${_rel}\", std::string_view(d${_i}, ${_size})},\n")
    math(EXPR _i "${_i} + 1")
endforeach()
string(APPEND _body "const EmbeddedFile kFiles[] = {\n${_table}    {\"\", std::string_view()}};\n}  // namespace\n\n")
string(APPEND _body "std::span<const EmbeddedFile> embeddedFiles() { return {kFiles, ${_i}}; }\n}  // namespace rk\n")
file(WRITE "${OUT}.tmp" "${_body}")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUT}.tmp")
